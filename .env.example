# ============================================================
# Smart Energy Management System — Environment Configuration
# ============================================================
# Copy this file to .env and adjust values.

# --- Database ---
# Default: SQLite (no Docker needed). Just works.
# To use PostgreSQL: DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/smart_energy
# DATABASE_URL=sqlite:///data/smart_energy.db

# --- MQTT (optional — disabled by default) ---
MQTT_ENABLED=false
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=energy_mqtt
MQTT_PASSWORD=change_me_in_production

# --- General ---
LOG_LEVEL=INFO
